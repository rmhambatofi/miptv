<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device: the Xtream passwords are sealed with a Keystore key that no backup or transfer carries,
  so restored data would only be unreadable. allowBackup="false" covers cloud backup; API 31+ device-to-device
  transfer needs these rules as well.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
