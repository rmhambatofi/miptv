<resources>
    <!-- The system starting window takes the dark ground, then the opening screen draws the logo. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B0D12</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#FF647C</item>
        <item name="android:windowSplashScreenBackground">#0B0D12</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
